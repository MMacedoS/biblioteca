{% for grupo in grupos %}
    <h2 class="h5 mt-4 grupo-autor">{{ grupo.autorNome }}</h2>
    <table class="table table-sm table-bordered bg-white">
        <thead>
            <tr>
                <th>Título</th>
                <th>Editora</th>
                <th class="text-center">Edição</th>
                <th class="text-center">Ano</th>
                <th>Assuntos</th>
                <th class="text-end">Valor</th>
            </tr>
        </thead>
        <tbody>
            {% for livro in grupo.livros %}
                <tr>
                    <td>{{ livro.titulo }}</td>
                    <td>{{ livro.editora }}</td>
                    <td class="text-center">{{ livro.edicao }}ª</td>
                    <td class="text-center">{{ livro.anoPublicacao }}</td>
                    <td>{{ livro.assuntos|default('—') }}</td>
                    <td class="text-end">{{ livro.valor|format_currency('BRL') }}</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th colspan="5" class="text-end">
                    {{ grupo.quantidade }} {{ grupo.quantidade == 1 ? 'livro' : 'livros' }} · Total
                </th>
                <th class="text-end">{{ grupo.valorTotal|format_currency('BRL') }}</th>
            </tr>
        </tfoot>
    </table>
{% else %}
    <p class="text-muted">Nenhum livro cadastrado.</p>
{% endfor %}
