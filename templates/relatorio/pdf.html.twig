<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Relatório de livros por autor</title>
    <style>
        body { font-family: 'DejaVu Sans', sans-serif; font-size: 10px; color: #222; }
        h1 { font-size: 16px; color: #1f4e79; margin: 0 0 4px; }
        .gerado-em { color: #666; margin-bottom: 12px; }
        .grupo-autor { font-size: 12px; color: #1f4e79; margin: 16px 0 4px; border-bottom: 2px solid #1f4e79; padding-bottom: 2px; }
        table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
        th, td { border: 1px solid #ccc; padding: 4px 6px; }
        thead th { background-color: #1f4e79; color: #fff; text-align: left; }
        tfoot th { background-color: #f0f3f7; }
        .text-center { text-align: center; }
        .text-end { text-align: right; }
    </style>
</head>
<body>
    <h1>Relatório de livros por autor</h1>
    <p class="gerado-em">Gerado em {{ geradoEm|format_datetime('short', 'short') }}</p>

    {% include 'relatorio/_tabelas.html.twig' %}
</body>
</html>
