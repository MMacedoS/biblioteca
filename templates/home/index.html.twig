{% extends 'base.html.twig' %}

{% block title %}Início · Biblioteca{% endblock %}

{% block body %}
    <h1 class="mb-4">Sistema de cadastro de livros</h1>

    <div class="row g-3">
        <div class="col-md-6 col-lg-3">
            <div class="card app-card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Livros</h2>
                    <p class="card-text text-muted">Cadastro de livros, com autores e assuntos.</p>
                    <a href="{{ path('livro_index') }}" class="btn btn-app btn-sm">Acessar</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card app-card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Autores</h2>
                    <p class="card-text text-muted">Cadastro dos autores dos livros.</p>
                    <a href="{{ path('autor_index') }}" class="btn btn-app btn-sm">Acessar</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-lg-3">
            <div class="card app-card h-100">
                <div class="card-body">
                    <h2 class="h5 card-title">Assuntos</h2>
                    <p class="card-text text-muted">Cadastro dos assuntos dos livros.</p>
                    <a href="{{ path('assunto_index') }}" class="btn btn-app btn-sm">Acessar</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
