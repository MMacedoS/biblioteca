{% extends 'base.html.twig' %}

{% block title %}Autores · Biblioteca{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Autores</h1>
        <a href="{{ path('autor_novo') }}" class="btn btn-app">Novo autor</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle bg-white">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nome</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for autor in autores %}
                    <tr>
                        <td>{{ autor.id }}</td>
                        <td>{{ autor.nome }}</td>
                        <td class="text-end">
                            <a href="{{ path('autor_editar', {id: autor.id}) }}" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <form method="post" action="{{ path('autor_excluir', {id: autor.id}) }}" class="d-inline"
                                  onsubmit="return confirm('Excluir o autor {{ autor.nome|e('js') }}?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('excluir_autor_' ~ autor.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-muted">Nenhum autor cadastrado.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
