{% extends 'base.html.twig' %}

{% block title %}{{ titulo }} · Biblioteca{% endblock %}

{% block body %}
    <h1 class="mb-4">{{ titulo }}</h1>

    <div class="card app-card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-7">{{ form_row(form.titulo) }}</div>
                    <div class="col-md-5">{{ form_row(form.editora) }}</div>
                </div>
                <div class="row">
                    <div class="col-md-4">{{ form_row(form.edicao) }}</div>
                    <div class="col-md-4">{{ form_row(form.anoPublicacao) }}</div>
                    <div class="col-md-4">{{ form_row(form.valor) }}</div>
                </div>
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.autores) }}</div>
                    <div class="col-md-6">{{ form_row(form.assuntos) }}</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-app">Salvar</button>
                    <a href="{{ path('livro_index') }}" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
