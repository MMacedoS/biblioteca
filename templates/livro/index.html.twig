{% extends 'base.html.twig' %}

{% block title %}Livros · Biblioteca{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Livros</h1>
        <a href="{{ path('livro_novo') }}" class="btn btn-app">Novo livro</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle bg-white">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Título</th>
                    <th>Editora</th>
                    <th class="text-center">Edição</th>
                    <th class="text-center">Ano</th>
                    <th class="text-end">Valor</th>
                    <th>Autores</th>
                    <th>Assuntos</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for livro in livros %}
                    <tr>
                        <td>{{ livro.id }}</td>
                        <td>{{ livro.titulo }}</td>
                        <td>{{ livro.editora }}</td>
                        <td class="text-center">{{ livro.edicao }}ª</td>
                        <td class="text-center">{{ livro.anoPublicacao }}</td>
                        <td class="text-end text-nowrap">{{ livro.valor|format_currency('BRL') }}</td>
                        <td>{{ livro.autores|map(a => a.nome)|join(', ') }}</td>
                        <td>{{ livro.assuntos|map(s => s.descricao)|join(', ')|default('—') }}</td>
                        <td class="text-end text-nowrap">
                            <a href="{{ path('livro_editar', {id: livro.id}) }}" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <form method="post" action="{{ path('livro_excluir', {id: livro.id}) }}" class="d-inline"
                                    onsubmit="return confirm('Excluir o livro {{ livro.titulo|e('js') }}?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('excluir_livro_' ~ livro.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="text-center text-muted">Nenhum livro cadastrado.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

    </div>
{% endblock %}
