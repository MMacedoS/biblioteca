{% extends 'base.html.twig' %}

{% block title %}Assuntos · Biblioteca{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Assuntos</h1>
        <a href="{{ path('assunto_novo') }}" class="btn btn-app">Novo assunto</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle bg-white">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Descrição</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                {% for assunto in assuntos %}
                    <tr>
                        <td>{{ assunto.id }}</td>
                        <td>{{ assunto.descricao }}</td>
                        <td class="text-end">
                            <a href="{{ path('assunto_editar', {id: assunto.id}) }}" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <form method="post" action="{{ path('assunto_excluir', {id: assunto.id}) }}" class="d-inline"
                                  onsubmit="return confirm('Excluir o assunto {{ assunto.descricao|e('js') }}?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('excluir_assunto_' ~ assunto.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="3" class="text-center text-muted">Nenhum assunto cadastrado.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
